{
  "title": "FinanceTracker",
  "config": {
    "step": {
      "user": {
        "title": "FinanceTracker",
        "description": "Every Home Assistant user gets a separate, private archive. Here you only choose the reminder time; each user picks the devices to notify in the FinanceTracker panel → Settings.",
        "data": {
          "notify_time": "Reminder time"
        }
      }
    },
    "abort": {
      "already_configured": "FinanceTracker is already set up.",
      "single_instance_allowed": "FinanceTracker is already set up."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Recurring expense reminders",
        "data": {
          "notify_time": "Reminder time"
        }
      }
    }
  },
  "entity": {
    "sensor": {
      "total_balance": {
        "name": "Total balance"
      },
      "account_balance": {
        "name": "{account} balance"
      },
      "income_month": {
        "name": "Income this month"
      },
      "expenses_month": {
        "name": "Expenses this month"
      },
      "net_month": {
        "name": "Net this month"
      },
      "recurring_monthly": {
        "name": "Monthly recurring expenses"
      },
      "recurring_due": {
        "name": "Recurring expenses due"
      }
    }
  },
  "services": {
    "aggiungi_movimento": {
      "name": "Add transaction",
      "description": "Records an expense, income or transfer in the user's archive.",
      "fields": {
        "importo": {
          "name": "Amount",
          "description": "Amount in euro, always positive."
        },
        "tipo": {
          "name": "Type",
          "description": "uscita (expense), entrata (income) or trasferimento (transfer)."
        },
        "categoria": {
          "name": "Category",
          "description": "Transaction category."
        },
        "descrizione": {
          "name": "Description",
          "description": "Free text."
        },
        "conto": {
          "name": "Account",
          "description": "Account the transaction belongs to (empty = first account)."
        },
        "conto_destinazione": {
          "name": "Destination account",
          "description": "Transfers only."
        },
        "metodo": {
          "name": "Payment method",
          "description": "Debit card, credit card, PayPal…"
        },
        "data": {
          "name": "Date",
          "description": "Empty = today."
        },
        "note": {
          "name": "Notes",
          "description": "Optional notes."
        },
        "utente": {
          "name": "User",
          "description": "Automations only: name of the Home Assistant user whose archive to write to. Empty = the user running the action."
        }
      }
    },
    "registra_spesa_fissa": {
      "name": "Register recurring expense",
      "description": "Records the instalment of a recurring expense and moves its due date forward.",
      "fields": {
        "spesa": {
          "name": "Recurring expense",
          "description": "Name or id of the recurring expense."
        },
        "importo": {
          "name": "Amount",
          "description": "Empty = expected amount."
        },
        "data": {
          "name": "Date",
          "description": "Empty = due date."
        },
        "utente": {
          "name": "User",
          "description": "Automations only: Home Assistant user name. Empty = the user running the action."
        }
      }
    }
  }
}